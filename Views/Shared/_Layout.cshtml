<!DOCTYPE html>
<html lang="pt-br"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>@ViewData["Title"] - Gerenciador Acadêmico</title><link rel="stylesheet" href="~/css/site.css" /></head>
<body><header><div class="container"><a asp-controller="Projetos" asp-action="Index" class="marca">Gerenciador Acadêmico</a><a asp-controller="Projetos" asp-action="Cadastrar">Novo projeto</a></div></header>
<main class="container">@RenderBody()</main><footer class="container">Gerenciador Acadêmico — projetos e professores</footer>
@await RenderSectionAsync("Scripts", required: false)</body></html>
